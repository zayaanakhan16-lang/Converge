# Converge environment configuration
#
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Any variable prefixed with EXPO_PUBLIC_ is embedded in the mobile bundle and
# must therefore never hold a secret. Server-side secrets belong to the backend.

# ---------------------------------------------------------------------------
# Mobile app (mobile/.env) - safe to expose, protected by Row Level Security
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Row Level Security enforces all access rules.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Converge Python backend, e.g. http://10.0.2.2:8000 for the
# Android emulator. Leave blank to disable AI features in the app.
EXPO_PUBLIC_BACKEND_URL=

# Optional MapLibre style. Defaults to the OpenFreeMap Liberty style, which
# renders OpenStreetMap data.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Set to "false" to force live mode even when Supabase is unset (not useful in
# practice, kept for explicit overrides during development).
EXPO_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Backend (backend/.env) - server-side only, never shipped to the client
# ---------------------------------------------------------------------------

# Supabase service role key. Bypasses Row Level Security: treat as a secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call the API.
CONVERGE_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Translation provider. Leave blank to keep translation disabled: the API will
# report `provider: "unavailable"` rather than returning invented text.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TRANSLATION_API_URL=

# Conversation coach model. Leave blank to run the deterministic rule-based
# coach, which produces real feedback from the submitted text with no model.
COACH_MODEL=
COACH_API_KEY=
COACH_API_URL=

# Shared secret required in the X-Converge-Client header for write endpoints.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONVERGE_CLIENT_TOKEN=

# Rate limiting (requests per minute per client identity).
CONVERGE_RATE_LIMIT_PER_MINUTE=60
